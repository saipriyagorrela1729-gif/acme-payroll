# Copy to .env and fill in before running `docker compose up`.
# Generate a secret with: openssl rand -hex 64
SECRET_KEY_BASE=replace-me

# The public hostname Caddy serves (and gets a TLS cert for).
# No domain? Use your VM's public IP in sslip.io form, e.g. 203-0-113-10.sslip.io
DOMAIN=your-domain-or-ip.sslip.io
