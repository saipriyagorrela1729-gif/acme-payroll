  [1m[36mSalaryRecord Pluck (0.5ms)[0m  [1m[34mSELECT "salary_records"."currency", SUM(CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END) AS total FROM "salary_records" INNER JOIN "employees" ON "employees"."id" = "salary_records"."employee_id" WHERE "salary_records"."id" IN (SELECT DISTINCT ON (salary_records.employee_id) salary_records.id FROM "salary_records" ORDER BY salary_records.employee_id, salary_records.effective_date DESC, salary_records.id DESC) GROUP BY "salary_records"."currency"[0m
  [1m[36mSalaryRecord Pluck (0.6ms)[0m  [1m[34mSELECT "employees"."department", "salary_records"."currency", COUNT(*) AS count, ROUND(AVG(CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END)) AS average, ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END)) AS median FROM "salary_records" INNER JOIN "employees" ON "employees"."id" = "salary_records"."employee_id" WHERE "salary_records"."id" IN (SELECT DISTINCT ON (salary_records.employee_id) salary_records.id FROM "salary_records" ORDER BY salary_records.employee_id, salary_records.effective_date DESC, salary_records.id DESC) GROUP BY "employees"."department", "salary_records"."currency"[0m
  [1m[36mSalaryRecord Pluck (0.6ms)[0m  [1m[34mSELECT "employees"."country", "salary_records"."currency", COUNT(*) AS count, ROUND(AVG(CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END)) AS average, ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END)) AS median FROM "salary_records" INNER JOIN "employees" ON "employees"."id" = "salary_records"."employee_id" WHERE "salary_records"."id" IN (SELECT DISTINCT ON (salary_records.employee_id) salary_records.id FROM "salary_records" ORDER BY salary_records.employee_id, salary_records.effective_date DESC, salary_records.id DESC) GROUP BY "employees"."country", "salary_records"."currency"[0m
  [1m[35m (0.6ms)[0m  [1m[34mSELECT currency, band, COUNT(*) AS count, MIN(min_amount) AS min_amount, MAX(max_amount) AS max_amount FROM ( SELECT cs.currency, WIDTH_BUCKET(cs.annualized, MIN(cs.annualized) OVER w, MAX(cs.annualized) OVER w + 0.01, 10) AS band, MIN(cs.annualized) OVER w AS min_amount, MAX(cs.annualized) OVER w AS max_amount FROM ( SELECT salary_records.currency, CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END AS annualized FROM salary_records WHERE salary_records.id IN ( SELECT DISTINCT ON (employee_id) id FROM salary_records ORDER BY employee_id, effective_date DESC, id DESC ) ) cs WINDOW w AS (PARTITION BY cs.currency) ) t GROUP BY currency, band, min_amount, max_amount ORDER BY currency, band[0m
  [1m[35m (0.4ms)[0m  [1m[34mSELECT currency, name, department, country, annualized_amount FROM ( SELECT salary_records.currency, employees.name, employees.department, employees.country, CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END AS annualized_amount, ROW_NUMBER() OVER ( PARTITION BY salary_records.currency ORDER BY CASE salary_records.frequency WHEN 'annual' THEN salary_records.amount WHEN 'monthly' THEN salary_records.amount * 12 WHEN 'hourly' THEN salary_records.amount * 2080 END DESC ) AS rank FROM salary_records JOIN employees ON employees.id = salary_records.employee_id WHERE salary_records.id IN ( SELECT DISTINCT ON (employee_id) id FROM salary_records ORDER BY employee_id, effective_date DESC, id DESC ) ) ranked WHERE rank <= 10[0m
